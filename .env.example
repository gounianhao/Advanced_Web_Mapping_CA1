# Meet Halfway - environment settings


# --- PostGIS database ---
POSTGRES_DB=meet_halfway
POSTGRES_USER=meet_halfway
POSTGRES_PASSWORD=change-me-db-password

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-secure-key
# True only while developing: shows error details to every visitor.
DJANGO_DEBUG=False
# Keep localhost and 127.0.0.1: the container health checks use them.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000

# Only turn these on once the site is served over HTTPS (see README, Known issues).
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- Web server ---
# Port the site is published on (http://localhost). If you change it,
# add the new address to DJANGO_CSRF_TRUSTED_ORIGINS, e.g. http://localhost:8080
HTTP_PORT=80
GUNICORN_WORKERS=3

# --- Docker network ---
# If Pool overlaps with other one on this address space
# change this one line (for example to 172.29.0) and run the stack again.
DOCKER_SUBNET_PREFIX=172.28.0
